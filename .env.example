#Application
APP_NAME=PulseMonitor
APP_ENV=development
App_DEBUG=True

# POSTGRES_USER=monitor
# POSTGRES_PASSWORD=monitor
# POSTGRES_DB=monitor
# Host-side port; internal container port stays 5432
# POSTGRES_PORT=5433

# PostgreSQL
# Use the pooled Neon URL for the FastAPI application and workers.
DATABASE_URL=postgresql+asyncpg://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Use the direct Neon URL for Alembic migrations.
DIRECT_DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require
#Redis
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me

# Later, for notifications
BREVO_API_KEY=
EMAIL_SENDER_ADDRESS=
EMAIL_SENDER_NAME=
#Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
