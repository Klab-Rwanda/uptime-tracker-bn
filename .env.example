APP_NAME=UpTimeTracker
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO

# Use the pooled URL for the application.
DATABASE_URL=postgresql+asyncpg://user:password@ep-example-pooler.region.aws.neon.tech/neondb?ssl=require
# Use the direct URL for Alembic migrations.
DIRECT_DATABASE_URL=postgresql+asyncpg://user:password@ep-example.region.aws.neon.tech/neondb?ssl=require
REDIS_URL=redis://redis:6379/0

# Generate a random secret with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ISSUER=uptimetracker-api
JWT_AUDIENCE=uptimetracker-client
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Brevo SMTP (SMTP login and key are in Brevo's SMTP settings)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
# Brevo API key for alert emails (SMTP & API -> API Keys, starts with xkeysib-)
BREVO_API_KEY=
EMAIL_CODE_TTL_MINUTES=10
APP_FRONTEND_URL=http://localhost:3000

# DEV ONLY: allow http:// and local/private webhook targets. Keep false in production.
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
