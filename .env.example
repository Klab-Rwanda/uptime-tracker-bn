POSTGRES_USER=monitor
POSTGRES_PASSWORD=monitor
POSTGRES_DB=monitor
# Host-side port; internal container port stays 5432
POSTGRES_PORT=5433

# Adjust the driver prefix to whatever the app uses (asyncpg, psycopg, ...)
DATABASE_URL=postgresql+asyncpg://monitor:monitor@postgres:5432/monitor
REDIS_URL=redis://redis:6379/0

# Generate a random secret with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ISSUER=uptimetracker-api
JWT_AUDIENCE=uptimetracker-client
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Brevo SMTP (SMTP login and key are in Brevo's SMTP settings)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
EMAIL_CODE_TTL_MINUTES=10
